{
  // Stricter check for production code (DR-052, ADR 0074): noUncheckedIndexedAccess on
  // every non-test file under src. Run by `pnpm typecheck`. Test files stay off: fixture
  // indexing would need ~640 guards for no safety gain.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.bench.ts"
  ]
}

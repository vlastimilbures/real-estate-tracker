{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window (ADR 0064; see docs/release.md).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "allow-db-transaction",
    "allow-db-select-snapshot",
    "allow-db-backup",
    "allow-log-error",
    "allow-perf-report",
    "allow-save-file",
    "allow-open-backup-file",
    "allow-write-app-backup",
    "allow-set-menu-labels"
  ]
}

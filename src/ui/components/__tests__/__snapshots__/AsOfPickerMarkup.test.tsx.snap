// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AsOfPicker markup > at +1y 1`] = `"<div class="asof" role="group" aria-label="As of date" data-testid="asof-picker"><span class="asof-label" id="«id»">As of</span><div class="date-input"><div class="input-wrap"><input class="has-trailing-btn" placeholder="dd.mm.yyyy" inputmode="text" aria-labelledby="«id»" aria-describedby="«id»" data-testid="asof-input" value="15.03.2028"><button type="button" class="date-trigger" aria-label="Open calendar" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar" aria-hidden="true"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg></button></div></div><div class="pill-group"><button type="button" class="pill" aria-pressed="false" data-testid="asof-today">Today</button><button type="button" class="pill on" aria-pressed="true" data-testid="asof-1y">+1y</button><button type="button" class="pill" aria-pressed="false" data-testid="asof-5y">+5y</button></div></div><div class="asof-foot"><span class="asof-hint" id="«id»" data-testid="asof-hint">Values at the year's end</span></div>"`;


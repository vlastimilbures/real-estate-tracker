{
  "name": "real-estate-tracker",
  "private": true,
  "version": "1.4.0",
  "description": "Local-first macOS desktop app for tracking a rental-apartment portfolio: mortgages, leases, valuations, 30-year nominal and real projections, KPIs and what-if scenarios.",
  "license": "MIT",
  "author": "Vlastimil Bureš",
  "repository": {
    "type": "git",
    "url": "https://github.com/vlastimilbures/real-estate-tracker.git"
  },
  "homepage": "https://github.com/vlastimilbures/real-estate-tracker#readme",
  "bugs": "https://github.com/vlastimilbures/real-estate-tracker/issues",
  "keywords": [
    "real-estate",
    "portfolio",
    "mortgage",
    "personal-finance",
    "tauri",
    "react",
    "typescript",
    "sqlite",
    "local-first",
    "macos"
  ],
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:check": "node scripts/check-bench.mjs",
    "test:parity": "vitest run src/engine/__tests__/parity src/data/__tests__/e2e.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ux:capture": "playwright test -c playwright.ux.config.ts",
    "ux:readme": "UX_SPEC=readme.spec.ts UX_THEME=both UX_VIEWPORT=1440x900 UX_SCALE=2 UX_RUN_ID=readme playwright test -c playwright.ux.config.ts",
    "ux:diff": "node ux-capture/diff.ts",
    "ux:axe-check": "node ux-capture/axeCheck.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json && tsc --noEmit -p ux-capture/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "knip": "knip",
    "mutation": "stryker run",
    "depcruise:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "depcruise:baseline-check": "node scripts/check-depcruise-baseline.mjs",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,jsonc,yaml,yml}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --max-warnings 0 --no-warn-ignored",
    "src/**/*.{ts,tsx}": "vitest related --run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "better-sqlite3": "^13.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sql.js": "^1.14.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
